Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Left Image
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /left/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Right Image
      Normalize Range: true
      Queue Size: 2
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /right/image_raw
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: VIO Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /path
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/PointCloud
      Enabled: true
      Name: VIO Point Cloud
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /point_cloud
      Style: Points
      Size (Pixels): 3
  Name: root
Window Geometry:
  Height: 800
  Width: 1200
